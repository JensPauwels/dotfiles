#!/usr/bin/env zsh
# pf - start, stop and pick long-running port forwards (kubectl port-forward,
# cloud-sql-proxy, ...). Each forward runs detached; its log and pid live in
# ~/.local/state/pf. Definitions come from ~/.config/pf/forwards.
#
#   pf                 interactive TUI (pf-tui, or the fzf picker as fallback)
#   pf start NAME...   pf stop NAME... | --all   pf toggle NAME   pf restart NAME
#   pf status          pf logs NAME [-f]         pf show NAME     pf edit
#   A port held by something pf did not start ("busy") is killed after a
#   prompt; -f / --force or PF_FORCE=1 skips the prompt.

set -u
setopt extended_glob
PF_SELF=${0:A} # inside functions $0 is the function name, fzf needs the script
PF_CONFIG="${PF_CONFIG:-$HOME/.config/pf/forwards}"
PF_STATE="${PF_STATE:-$HOME/.local/state/pf}"
PF_FORCE="${PF_FORCE:-0}"
mkdir -p "$PF_STATE"

typeset -a NAMES PORTS CMDS

if [[ -t 1 ]]; then
	C_GREEN=$'\e[32m' C_RED=$'\e[31m' C_YELLOW=$'\e[33m' C_DIM=$'\e[2m' C_OFF=$'\e[0m'
else
	C_GREEN='' C_RED='' C_YELLOW='' C_DIM='' C_OFF=''
fi

die() {
	print -r -- "pf: $*" >&2
	exit 1
}

# forwards file: NAME  PORT  COMMAND...  (blank lines and # comments ignored)
load() {
	NAMES=() PORTS=() CMDS=()
	[[ -r $PF_CONFIG ]] || die "no config at $PF_CONFIG"
	local line name port cmd
	while IFS= read -r line || [[ -n $line ]]; do
		line="${line%%$'\r'}"
		[[ -z ${line//[[:space:]]/} || ${line[1]} == '#' ]] && continue
		name=${line%%[[:space:]]*}
		line=${line#"$name"}
		line=${line##[[:space:]]#}
		port=${line%%[[:space:]]*}
		cmd=${line#"$port"}
		cmd=${cmd##[[:space:]]#}
		[[ $port == <-> && -n $cmd ]] || die "bad line in $PF_CONFIG: $name"
		NAMES+=("$name") PORTS+=("$port") CMDS+=("$cmd")
	done <"$PF_CONFIG"
}

index_of() {
	local i
	for ((i = 1; i <= ${#NAMES}; i++)); do
		[[ ${NAMES[i]} == "$1" ]] && { print -- $i; return 0; }
	done
	return 1
}

pid_of() {
	local f=$PF_STATE/$1.pid
	[[ -r $f ]] && cat "$f"
}

alive() {
	[[ -n ${1:-} ]] && kill -0 "$1" 2>/dev/null
}

port_pid() {
	lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -n 1
}

# Docker container publishing a host port (through OrbStack or Docker
# Desktop the listening pid is the VM helper, never the container itself).
docker_owner() {
	local pid=$1 port=$2 args
	args=$(ps -p "$pid" -o args= 2>/dev/null)
	[[ $args == *OrbStack* || $args == *com.docker* || $args == *docker* ]] || return 1
	command -v docker >/dev/null || return 1
	docker ps --format '{{.Names}}\t{{.Ports}}' 2>/dev/null |
		awk -F'\t' -v p=":$port->" 'index($2, p) { print $1; exit }'
}

# "pid 123  kubectl port-forward ..." or "docker container NAME" for
# whatever listens on a port
busy_desc() {
	local pid args name
	pid=$(port_pid "$1")
	[[ -n $pid ]] || return 1
	name=$(docker_owner "$pid" "$1")
	if [[ -n $name ]]; then
		print -r -- "docker container $name"
		return 0
	fi
	args=$(ps -p "$pid" -o args= 2>/dev/null)
	print -r -- "pid $pid  ${args:-?}"
}

# Kill the foreign process on a port, after asking unless forced.
kill_busy() {
	local name=$1 port=$2 pid desc n reply
	pid=$(port_pid "$port")
	[[ -n $pid ]] || return 0
	desc=$(busy_desc "$port")
	print -r -- "$(icon_of busy) $name: port $port is used by ${desc[1,110]}"
	local container=${desc#docker container }
	[[ $desc == docker\ container\ * ]] || container=""
	if [[ $PF_FORCE != 1 ]]; then
		local what="kill it"
		[[ -n $container ]] && what="stop the container"
		[[ -t 0 ]] || { print -- "    not a terminal, use -f to $what" >&2; return 1; }
		if [[ -n $container ]]; then
			read -q "reply?    stop the container? [y/N] " || { print; return 1; }
		else
			read -q "reply?    kill it? [y/N] " || { print; return 1; }
		fi
		print
	fi
	if [[ -n $container ]]; then
		docker stop "$container" >/dev/null 2>&1 || { print -r -- "$(icon_of busy) $name: docker stop $container failed" >&2; return 1; }
		sleep 0.3
		if [[ -n $(port_pid "$port") ]]; then
			print -r -- "$(icon_of busy) $name: port $port is still in use" >&2
			return 1
		fi
		print -- "$(icon_of stopped) stopped container $container, port $port is free"
		return 0
	fi
	kill "$pid" 2>/dev/null
	n=0
	while alive "$pid" && ((n < 20)); do
		sleep 0.25
		((n++))
	done
	alive "$pid" && kill -9 "$pid" 2>/dev/null
	sleep 0.2
	if [[ -n $(port_pid "$port") ]]; then
		print -r -- "$(icon_of busy) $name: port $port is still in use" >&2
		return 1
	fi
	print -- "$(icon_of stopped) killed pid $pid, port $port is free"
}

# running | died | busy | stopped
state_of() {
	local name=$1 port=$2 pid
	pid=$(pid_of "$name")
	if alive "$pid"; then
		print running
	elif [[ -n $pid ]]; then
		print died
	elif [[ -n $(port_pid "$port") ]]; then
		print busy
	else
		print stopped
	fi
}

icon_of() {
	case $1 in
	running) print -- "${C_GREEN}●${C_OFF}" ;;
	died) print -- "${C_RED}✗${C_OFF}" ;;
	busy) print -- "${C_YELLOW}!${C_OFF}" ;;
	*) print -- "${C_DIM}○${C_OFF}" ;;
	esac
}

require() {
	local i
	i=$(index_of "$1") || die "unknown forward '$1' (see: pf status)"
	print -- $i
}

start_one() {
	local name=$1 i port cmd st log pid n
	i=$(require "$name") || return 1
	port=${PORTS[i]} cmd=${CMDS[i]}
	st=$(state_of "$name" "$port")
	if [[ $st == running ]]; then
		print -- "$(icon_of running) $name already running on :$port"
		return 0
	fi
	rm -f "$PF_STATE/$name.pid" # a previous run that died
	if [[ -n $(port_pid "$port") ]]; then
		kill_busy "$name" "$port" || return 1
	fi
	log=$PF_STATE/$name.log
	print -r -- "# $(date '+%F %T') pf start: $cmd" >"$log"
	nohup zsh -c "exec $cmd" </dev/null >>"$log" 2>&1 &!
	pid=$!
	print -- $pid >"$PF_STATE/$name.pid"
	n=0
	while ((n < 60)); do
		if ! alive "$pid"; then
			print -r -- "$(icon_of died) $name exited right away:" >&2
			tail -n 5 "$log" | sed 's/^/    /' >&2
			rm -f "$PF_STATE/$name.pid"
			return 1
		fi
		if [[ -n $(port_pid "$port") ]]; then
			print -- "$(icon_of running) $name listening on 127.0.0.1:$port ${C_DIM}(pid $pid)${C_OFF}"
			return 0
		fi
		sleep 0.25
		((n++))
	done
	print -- "$(icon_of running) $name started (pid $pid) but :$port is not listening yet, see: pf logs $name"
}

stop_one() {
	local name=$1 i pid n
	i=$(require "$name") || return 1
	pid=$(pid_of "$name")
	if ! alive "$pid"; then
		rm -f "$PF_STATE/$name.pid"
		if [[ -n $(port_pid "${PORTS[i]}") ]]; then
			kill_busy "$name" "${PORTS[i]}"
			return $?
		fi
		print -- "$(icon_of stopped) $name is not running"
		return 0
	fi
	kill "$pid" 2>/dev/null
	n=0
	while alive "$pid" && ((n < 20)); do
		sleep 0.25
		((n++))
	done
	alive "$pid" && kill -9 "$pid" 2>/dev/null
	rm -f "$PF_STATE/$name.pid"
	print -- "$(icon_of stopped) $name stopped"
}

toggle_one() {
	local name=$1 i
	i=$(require "$name") || return 1
	case $(state_of "$name" "${PORTS[i]}") in
	running) stop_one "$name" ;;
	busy) kill_busy "$name" "${PORTS[i]}" && start_one "$name" ;;
	*) start_one "$name" ;;
	esac
}

status_all() {
	local i st pid
	for ((i = 1; i <= ${#NAMES}; i++)); do
		st=$(state_of "${NAMES[i]}" "${PORTS[i]}")
		pid=$(pid_of "${NAMES[i]}")
		printf '%s %-22s :%-5s %-8s %s%s%s\n' "$(icon_of "$st")" "${NAMES[i]}" "${PORTS[i]}" "$st" \
			"$C_DIM" "${pid:+pid $pid  }${CMDS[i][1,60]}" "$C_OFF"
	done
}

# tab-separated: name port state pid owner command  (for pf-tui)
state_lines() {
	local i st pid owner
	for ((i = 1; i <= ${#NAMES}; i++)); do
		st=$(state_of "${NAMES[i]}" "${PORTS[i]}")
		pid=$(pid_of "${NAMES[i]}")
		owner=""
		[[ $st == busy ]] && owner=$(busy_desc "${PORTS[i]}")
		printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${NAMES[i]}" "${PORTS[i]}" "$st" "$pid" "$owner" "${CMDS[i]}"
	done
}

# one line per forward, name in field 2, for fzf
list_lines() {
	local i st
	for ((i = 1; i <= ${#NAMES}; i++)); do
		st=$(state_of "${NAMES[i]}" "${PORTS[i]}")
		printf '%s %-22s :%-5s %s%s%s\n' "$(icon_of "$st")" "${NAMES[i]}" "${PORTS[i]}" "$C_DIM" "$st" "$C_OFF"
	done
}

show_one() {
	local name=$1 i st pid log
	i=$(require "$name") || return 1
	st=$(state_of "$name" "${PORTS[i]}")
	pid=$(pid_of "$name")
	print -- "$(icon_of "$st") $name  ·  $st${pid:+  ·  pid $pid}"
	print -- "port     127.0.0.1:${PORTS[i]}"
	print -r -- "command  ${CMDS[i]}"
	[[ $st == busy ]] && print -r -- "busy     $(busy_desc "${PORTS[i]}")"
	log=$PF_STATE/$name.log
	if [[ -r $log ]]; then
		print
		print -- "${C_DIM}── log ──${C_OFF}"
		tail -n 20 "$log"
	fi
}

logs_one() {
	local name=$1 log
	index_of "$name" >/dev/null || die "unknown forward '$name'"
	log=$PF_STATE/$name.log
	[[ -r $log ]] || die "no log yet for $name"
	if [[ ${2:-} == -f ]]; then
		tail -n 40 -f "$log"
	else
		tail -n "${2:-40}" "$log"
	fi
}

pick() {
	local tui=${PF_SELF:h}/pf-tui
	if [[ -x $tui && -t 1 ]]; then
		exec "$tui"
	fi
	command -v fzf >/dev/null || die "neither pf-tui (run ~/dotfiles/pf/build.sh) nor fzf is available; use: pf start NAME"
	local sel name
	while true; do
		sel=$(
			C_GREEN=$'\e[32m' C_RED=$'\e[31m' C_YELLOW=$'\e[33m' C_DIM=$'\e[2m' C_OFF=$'\e[0m' list_lines |
				fzf --ansi --multi --no-sort --layout=reverse \
					--header 'enter: toggle (busy: kill + start, asks first)  ·  tab: mark several  ·  esc: quit' \
					--preview "$PF_SELF show {2}" --preview-window 'right,55%,wrap' \
					--bind 'ctrl-r:reload('"$PF_SELF"' list)'
		) || return 0
		[[ -z $sel ]] && return 0
		while IFS= read -r line; do
			name=${${(z)line}[2]}
			toggle_one "$name"
		done <<<"$sel"
	done
}

usage() {
	sed -n '2,9p' "$PF_SELF" | sed 's/^# \{0,1\}//'
}

main() {
	local -a rest
	local a
	for a in "$@"; do
		case $a in
		-f | --force) PF_FORCE=1 ;;
		*) rest+=("$a") ;;
		esac
	done
	set -- "${rest[@]}"
	local cmd=${1:-pick}
	shift $(($# > 0 ? 1 : 0))
	load
	case $cmd in
	pick) pick ;;
	start)
		(($#)) || die "usage: pf start NAME..."
		local n rc=0
		for n in "$@"; do start_one "$n" || rc=1; done
		return $rc
		;;
	stop)
		(($#)) || die "usage: pf stop NAME... | --all"
		local n rc=0
		if [[ $1 == --all || $1 == -a ]]; then
			for n in "${NAMES[@]}"; do
				[[ $(state_of "$n" "${PORTS[$(index_of "$n")]}") == running ]] && { stop_one "$n" || rc=1; }
			done
		else
			for n in "$@"; do stop_one "$n" || rc=1; done
		fi
		return $rc
		;;
	toggle)
		(($#)) || die "usage: pf toggle NAME"
		toggle_one "$1"
		;;
	restart)
		(($#)) || die "usage: pf restart NAME"
		stop_one "$1" && start_one "$1"
		;;
	status | ls) status_all ;;
	list) C_GREEN=$'\e[32m' C_RED=$'\e[31m' C_YELLOW=$'\e[33m' C_DIM=$'\e[2m' C_OFF=$'\e[0m' list_lines ;;
	list-names) print -l -- "${NAMES[@]}" ;;
	state) state_lines ;;
	show)
		(($#)) || die "usage: pf show NAME"
		show_one "$1"
		;;
	logs)
		(($#)) || die "usage: pf logs NAME [-f|N]"
		logs_one "$@"
		;;
	edit) ${EDITOR:-nvim} "$PF_CONFIG" ;;
	-h | --help | help) usage ;;
	*) die "unknown command '$cmd' (try: pf help)" ;;
	esac
}

main "$@"
